# ---------- server ----------
PORT=10000                 # Render sets this automatically
NODE_ENV=production

# ---------- CORS ----------
# Browsers may call the API only from these origins (comma separated, no trailing slash).
# Production:
CORS_ORIGINS=https://avkasco.com,https://www.avkasco.com
# While testing on the temporary Render address, ADD it, e.g.
# CORS_ORIGINS=https://avkasco.com,https://www.avkasco.com,https://avkas-site.onrender.com
# and remove it again after go-live.

# ---------- Amazon SES (set these in Render → Environment, never in GitHub) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Must be a VERIFIED SES identity (address or domain), e.g.  AVKAS Website <no-reply@avkasco.com>
SES_FROM_EMAIL=
# Where enquiries and applications are delivered (comma separated for several people)
SES_TO_EMAIL=heetshah@gmail.com
